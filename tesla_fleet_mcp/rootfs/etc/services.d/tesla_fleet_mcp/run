#!/usr/bin/with-contenv bashio
# ==============================================================================
# Tesla Fleet MCP — Streamable HTTP
# ==============================================================================
set -euo pipefail

DATA="/data"
CACHE="${DATA}/token-cache.json"

if [[ ! -f "${CACHE}" ]]; then
  ACCESS="$(bashio::config 'tesla_access_token')"
  REFRESH="$(bashio::config 'tesla_refresh_token')"
  EXPIRES="$(bashio::config 'tesla_expires_at')"
  if [[ -n "${ACCESS}" && -n "${REFRESH}" ]]; then
    bashio::log.info "Seeding Tesla token cache from add-on options"
    python3 - <<PY
import json
from pathlib import Path
Path("${CACHE}").write_text(json.dumps({
  "access_token": """${ACCESS}""",
  "refresh_token": """${REFRESH}""",
  "expires_at": int("${EXPIRES}" or 0),
}))
PY
    chmod 600 "${CACHE}"
  else
    bashio::log.warning "No token cache yet — run OAuth / provide seed tokens in options"
  fi
fi

export TESLA_CLIENT_ID="$(bashio::config 'tesla_client_id')"
export TESLA_CLIENT_SECRET="$(bashio::config 'tesla_client_secret')"
export TESLA_REDIRECT_URI="$(bashio::config 'tesla_redirect_uri')"
export TESLA_AUDIENCE="$(bashio::config 'tesla_audience')"
export TESLA_REGION="$(bashio::config 'tesla_region')"
export TESLA_MCP_TOKEN="$(bashio::config 'tesla_mcp_token')"
export TESLA_MCP_HOST="$(bashio::config 'tesla_mcp_host')"
export TESLA_MCP_PORT="$(bashio::config 'tesla_mcp_port')"
export TESLA_CACHE_PATH="${CACHE}"
export MCP_TRANSPORT=http

cd /opt/tesla-fleet-mcp
exec npx tsx src/index.ts --http
